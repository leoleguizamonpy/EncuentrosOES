generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized    String                   @unique(map: "users_email_normalized_key") @map("email_normalized")
  displayName        String                   @map("display_name")
  passwordHash       String                   @map("password_hash")
  status             String
  role               String                   @default("ADMIN")
  credentialVersion  Int                      @default(1) @map("credential_version")
  failedLoginCount   Int                      @default(0) @map("failed_login_count")
  loginBlockedUntil  DateTime?                @map("login_blocked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  editionsCreated    Edition[]                @relation("EditionCreatedBy")
  editionsUpdated    Edition[]                @relation("EditionUpdatedBy")
  institutionsCreated Institution[]           @relation("InstitutionCreatedBy")
  institutionsUpdated Institution[]           @relation("InstitutionUpdatedBy")
  competitionsCreated Competition[]           @relation("CompetitionCreatedBy")
  competitionsUpdated Competition[]           @relation("CompetitionUpdatedBy")
  competitionsLocked Competition[]            @relation("CompetitionLockedBy")
  competitionsFinalized Competition[]         @relation("CompetitionFinalizedBy")
  participantsEnabled CompetitionParticipant[] @relation("ParticipantEnabledBy")
  ruleSetsCreated     CompetitionRuleSet[]      @relation("RuleSetCreatedBy")
  ruleSetsUpdated     CompetitionRuleSet[]      @relation("RuleSetUpdatedBy")
  ruleSetsFrozen      CompetitionRuleSet[]      @relation("RuleSetFrozenBy")
  drawConfigurationsCreated DrawConfiguration[] @relation("DrawConfigurationCreatedBy")
  drawConfigurationsUpdated DrawConfiguration[] @relation("DrawConfigurationUpdatedBy")
  drawConfigurationsFrozen  DrawConfiguration[] @relation("DrawConfigurationFrozenBy")
  officialDrawsExecuted OfficialDraw[]         @relation("OfficialDrawExecutedBy")
  officialDrawsConfirmed OfficialDraw[]        @relation("OfficialDrawConfirmedBy")
  officialDrawsAnnulled OfficialDraw[]          @relation("OfficialDrawAnnulledBy")
  matchResultsRecorded MatchResult[]            @relation("MatchResultRecordedBy")
  matchResultsConfirmed MatchResult[]           @relation("MatchResultConfirmedBy")
  matchResultsAnnulled MatchResult[]             @relation("MatchResultAnnulledBy")
  qualificationsProposed GroupQualification[]    @relation("QualificationProposedBy")
  qualificationsConfirmed GroupQualification[]   @relation("QualificationConfirmedBy")
  qualificationsInvalidated GroupQualification[] @relation("QualificationInvalidatedBy")
  qualificationsAnnulled GroupQualification[]     @relation("QualificationAnnulledBy")
  sessions           UserSession[]

  @@map("users")
}

model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique(map: "user_sessions_token_hash_key") @map("token_hash") @db.Char(64)
  csrfHash          String    @map("csrf_hash") @db.Char(64)
  credentialVersion Int       @map("credential_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revision          Int       @default(1)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Edition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year        Int      @unique
  name        String
  status      String
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String   @map("updated_by") @db.Uuid
  createdBy   User     @relation("EditionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User     @relation("EditionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  competitions Competition[]

  @@map("editions")
}

model Event {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String               @unique
  name         String
  active       Boolean              @default(true)
  institutions Institution[]
  combinations EventSportModality[]

  @@map("events")
}

model Institution {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  code           String
  name           String
  normalizedName String   @map("normalized_name")
  active         Boolean  @default(true)
  revision       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String   @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String   @map("updated_by") @db.Uuid
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy      User     @relation("InstitutionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User     @relation("InstitutionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  participants   CompetitionParticipant[]

  @@unique([eventId, code])
  @@unique([eventId, normalizedName])
  @@unique([eventId, id])
  @@map("institutions")
}

model Sport {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String               @unique
  name         String
  active       Boolean              @default(true)
  combinations EventSportModality[]

  @@map("sports")
}

model Modality {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String               @unique
  name         String
  active       Boolean              @default(true)
  combinations EventSportModality[]

  @@map("modalities")
}

model EventSportModality {
  eventId     String        @map("event_id") @db.Uuid
  sportId     String        @map("sport_id") @db.Uuid
  modalityId  String        @map("modality_id") @db.Uuid
  active      Boolean       @default(true)
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  sport       Sport         @relation(fields: [sportId], references: [id], onDelete: Restrict)
  modality    Modality      @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  competitions Competition[]

  @@id([eventId, sportId, modalityId])
  @@map("event_sport_modalities")
}

model Competition {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  editionId     String    @map("edition_id") @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  sportId       String    @map("sport_id") @db.Uuid
  modalityId    String    @map("modality_id") @db.Uuid
  status        String    @default("DRAFT")
  formatCode    String?   @map("format_code")
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedById    String?   @map("locked_by") @db.Uuid
  finalizedAt   DateTime? @map("finalized_at") @db.Timestamptz(6)
  finalizedById String?   @map("finalized_by") @db.Uuid
  revision      Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String    @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById   String    @map("updated_by") @db.Uuid
  edition       Edition   @relation(fields: [editionId], references: [id], onDelete: Restrict)
  combination   EventSportModality @relation(fields: [eventId, sportId, modalityId], references: [eventId, sportId, modalityId], onDelete: Restrict)
  createdBy     User      @relation("CompetitionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User      @relation("CompetitionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  lockedBy      User?     @relation("CompetitionLockedBy", fields: [lockedById], references: [id], onDelete: Restrict)
  finalizedBy   User?     @relation("CompetitionFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  participants  CompetitionParticipant[]
  ruleSets      CompetitionRuleSet[]
  drawConfigurations DrawConfiguration[]
  officialDraws OfficialDraw[]
  matches       LogicalMatch[]
  groupQualifications GroupQualification[]

  @@unique([editionId, eventId, sportId, modalityId])
  @@unique([eventId, id])
  @@index([editionId, eventId, status])
  @@map("competitions")
}

model CompetitionParticipant {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId String      @map("competition_id") @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  displayName   String      @map("display_name")
  status        String      @default("ENABLED")
  enabledAt     DateTime    @map("enabled_at") @db.Timestamptz(6)
  enabledById   String      @map("enabled_by") @db.Uuid
  revision      Int         @default(1)
  competition   Competition @relation(fields: [eventId, competitionId], references: [eventId, id], onDelete: Restrict)
  institution   Institution @relation(fields: [eventId, institutionId], references: [eventId, id], onDelete: Restrict)
  enabledBy     User        @relation("ParticipantEnabledBy", fields: [enabledById], references: [id], onDelete: Restrict)
  drawConfigurations DrawConfigurationParticipant[]
  groupMemberships DrawGroupMember[]
  pairingsAsA DrawPairing[] @relation("PairingParticipantA")
  pairingsAsB DrawPairing[] @relation("PairingParticipantB")
  matchesAsA LogicalMatch[] @relation("MatchParticipantA")
  matchesAsB LogicalMatch[] @relation("MatchParticipantB")
  matchesWon LogicalMatch[] @relation("MatchWinner")
  resultsAsA MatchResult[] @relation("ResultParticipantA")
  resultsAsB MatchResult[] @relation("ResultParticipantB")
  resultsWon MatchResult[] @relation("ResultWinner")
  groupStandings GroupStanding[]
  qualificationsAsFirst GroupQualification[] @relation("QualificationFirstParticipant")
  qualificationsAsSecond GroupQualification[] @relation("QualificationSecondParticipant")

  @@unique([competitionId, institutionId])
  @@unique([competitionId, id])
  @@map("competition_participants")
}

model CompetitionRuleSet {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId            String                   @map("competition_id") @db.Uuid
  schemaVersion            Int                      @map("schema_version")
  revisionNumber           Int                      @map("revision_number")
  resultProfile            String                   @map("result_profile")
  profileConfig            Json                     @map("profile_config") @db.JsonB
  knockoutResolutionCode   String                   @map("knockout_resolution_code")
  status                   String                   @default("DRAFT")
  canonicalHash            String?                  @map("canonical_hash") @db.Char(64)
  frozenAt                 DateTime?                @map("frozen_at") @db.Timestamptz(6)
  frozenById               String?                  @map("frozen_by") @db.Uuid
  revision                 Int                      @default(1)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById              String                   @map("created_by") @db.Uuid
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById              String                   @map("updated_by") @db.Uuid
  competition              Competition              @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  createdBy                User                     @relation("RuleSetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User                     @relation("RuleSetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  frozenBy                 User?                    @relation("RuleSetFrozenBy", fields: [frozenById], references: [id], onDelete: Restrict)
  outcomes                 RuleSetOutcome[]
  metrics                  RuleSetMetric[]
  tiebreaks                RuleSetTiebreak[]
  drawConfigurations       DrawConfiguration[]
  matchResults             MatchResult[]
  groupQualifications      GroupQualification[]

  @@unique([competitionId, revisionNumber])
  @@unique([competitionId, id])
  @@index([competitionId, status])
  @@map("competition_rule_sets")
}

model RuleSetOutcome {
  ruleSetId   String             @map("rule_set_id") @db.Uuid
  outcomeCode String             @map("outcome_code")
  tablePoints Int                @map("table_points")
  description String
  ruleSet     CompetitionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@id([ruleSetId, outcomeCode])
  @@map("rule_set_outcomes")
}

model RuleSetMetric {
  ruleSetId  String             @map("rule_set_id") @db.Uuid
  metricCode String             @map("metric_code")
  enabled    Boolean            @default(true)
  ruleSet    CompetitionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@id([ruleSetId, metricCode])
  @@map("rule_set_metrics")
}

model RuleSetTiebreak {
  ruleSetId     String             @map("rule_set_id") @db.Uuid
  position      Int
  criterionCode String             @map("criterion_code")
  config        Json?              @db.JsonB
  ruleSet       CompetitionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@id([ruleSetId, position])
  @@unique([ruleSetId, criterionCode])
  @@map("rule_set_tiebreaks")
}

model DrawConfiguration {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId      String             @map("competition_id") @db.Uuid
  ruleSetId          String             @map("rule_set_id") @db.Uuid
  roundNumber        Int                @map("round_number")
  formatCode         String             @map("format_code")
  groupCount         Int?               @map("group_count")
  participantCount   Int                @map("participant_count")
  algorithmVersion   String             @default("oes-draw-v1") @map("algorithm_version")
  status             String             @default("DRAFT")
  canonicalHash      String?            @map("canonical_hash") @db.Char(64)
  frozenAt           DateTime?          @map("frozen_at") @db.Timestamptz(6)
  frozenById         String?            @map("frozen_by") @db.Uuid
  revision           Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String             @map("created_by") @db.Uuid
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById        String             @map("updated_by") @db.Uuid
  competition        Competition        @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  ruleSet            CompetitionRuleSet @relation(fields: [competitionId, ruleSetId], references: [competitionId, id], onDelete: Restrict)
  createdBy          User               @relation("DrawConfigurationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User               @relation("DrawConfigurationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  frozenBy           User?              @relation("DrawConfigurationFrozenBy", fields: [frozenById], references: [id], onDelete: Restrict)
  participants       DrawConfigurationParticipant[]
  executions         OfficialDraw[]

  @@unique([competitionId, id])
  @@index([competitionId, roundNumber, status])
  @@map("draw_configurations")
}

model DrawConfigurationParticipant {
  drawConfigurationId     String                 @map("draw_configuration_id") @db.Uuid
  competitionId           String                 @map("competition_id") @db.Uuid
  competitionParticipantId String                @map("competition_participant_id") @db.Uuid
  canonicalOrder          Int                    @map("canonical_order")
  displayNameSnapshot     String                 @map("display_name_snapshot")
  byeCountSnapshot        Int                    @map("bye_count_snapshot")
  configuration           DrawConfiguration      @relation(fields: [competitionId, drawConfigurationId], references: [competitionId, id], onDelete: Restrict)
  participant             CompetitionParticipant @relation(fields: [competitionId, competitionParticipantId], references: [competitionId, id], onDelete: Restrict)

  @@id([drawConfigurationId, competitionParticipantId])
  @@unique([drawConfigurationId, canonicalOrder])
  @@map("draw_configuration_participants")
}

model OfficialDraw {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId      String            @map("competition_id") @db.Uuid
  configurationId    String            @map("configuration_id") @db.Uuid
  status             String            @default("PENDING_CONFIRMATION")
  algorithmVersion   String            @map("algorithm_version")
  evidenceJson       Json              @map("evidence_json") @db.JsonB
  evidenceHash       String            @map("evidence_hash") @db.Char(64)
  resultHash         String            @map("result_hash") @db.Char(64)
  seedCommitment     String            @map("seed_commitment") @db.Char(64)
  seedHex            String            @map("seed_hex") @db.Char(64)
  executedAt         DateTime          @map("executed_at") @db.Timestamptz(6)
  executedById       String            @map("executed_by") @db.Uuid
  confirmedAt        DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  confirmedById      String?           @map("confirmed_by") @db.Uuid
  annulledAt         DateTime?         @map("annulled_at") @db.Timestamptz(6)
  annulledById       String?           @map("annulled_by") @db.Uuid
  annulmentReason    String?           @map("annulment_reason")
  revision           Int               @default(1)
  competition        Competition       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  configuration      DrawConfiguration @relation(fields: [competitionId, configurationId], references: [competitionId, id], onDelete: Restrict)
  executedBy         User              @relation("OfficialDrawExecutedBy", fields: [executedById], references: [id], onDelete: Restrict)
  confirmedBy        User?             @relation("OfficialDrawConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  annulledBy         User?             @relation("OfficialDrawAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  groups             DrawGroup[]
  pairings           DrawPairing[]
  matches            LogicalMatch[]

  @@unique([competitionId, id])
  @@index([competitionId, status])
  @@map("official_draws")
}

model DrawGroup {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId   String            @map("execution_id") @db.Uuid
  competitionId String            @map("competition_id") @db.Uuid
  ordinal       Int
  label         String
  execution     OfficialDraw      @relation(fields: [competitionId, executionId], references: [competitionId, id], onDelete: Restrict)
  members       DrawGroupMember[]
  matches       LogicalMatch[]
  standings     GroupStanding[]
  qualifications GroupQualification[]

  @@unique([competitionId, id])
  @@unique([executionId, ordinal])
  @@unique([executionId, label])
  @@map("draw_groups")
}

model DrawGroupMember {
  groupId       String                 @map("group_id") @db.Uuid
  competitionId String                 @map("competition_id") @db.Uuid
  participantId String                 @map("participant_id") @db.Uuid
  memberOrdinal Int                    @map("member_ordinal")
  group         DrawGroup              @relation(fields: [competitionId, groupId], references: [competitionId, id], onDelete: Restrict)
  participant   CompetitionParticipant @relation(fields: [competitionId, participantId], references: [competitionId, id], onDelete: Restrict)

  @@id([groupId, participantId])
  @@unique([groupId, memberOrdinal])
  @@map("draw_group_members")
}

model DrawPairing {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId           String                  @map("execution_id") @db.Uuid
  competitionId         String                  @map("competition_id") @db.Uuid
  ordinal               Int
  pairingType           String                  @map("pairing_type")
  participantAId        String                  @map("participant_a_id") @db.Uuid
  participantBId        String?                 @map("participant_b_id") @db.Uuid
  priorByeCount         Int?                    @map("prior_bye_count")
  execution             OfficialDraw            @relation(fields: [competitionId, executionId], references: [competitionId, id], onDelete: Restrict)
  participantA          CompetitionParticipant  @relation("PairingParticipantA", fields: [competitionId, participantAId], references: [competitionId, id], onDelete: Restrict)
  participantB          CompetitionParticipant? @relation("PairingParticipantB", fields: [competitionId, participantBId], references: [competitionId, id], onDelete: Restrict)
  matches               LogicalMatch[]

  @@unique([competitionId, id])
  @@unique([executionId, ordinal])
  @@map("draw_pairings")
}

model LogicalMatch {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId  String                 @map("competition_id") @db.Uuid
  executionId    String                 @map("execution_id") @db.Uuid
  roundNumber    Int                    @map("round_number")
  groupId        String?                @map("group_id") @db.Uuid
  pairingId      String?                @map("pairing_id") @db.Uuid
  ordinal        Int
  participantAId String                 @map("participant_a_id") @db.Uuid
  participantBId String                 @map("participant_b_id") @db.Uuid
  status         String                 @default("PENDING_RESULT")
  winnerParticipantId String?           @map("winner_participant_id") @db.Uuid
  competition    Competition            @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  execution      OfficialDraw           @relation(fields: [competitionId, executionId], references: [competitionId, id], onDelete: Restrict)
  group          DrawGroup?             @relation(fields: [competitionId, groupId], references: [competitionId, id], onDelete: Restrict)
  pairing        DrawPairing?           @relation(fields: [competitionId, pairingId], references: [competitionId, id], onDelete: Restrict)
  participantA   CompetitionParticipant @relation("MatchParticipantA", fields: [competitionId, participantAId], references: [competitionId, id], onDelete: Restrict)
  participantB   CompetitionParticipant @relation("MatchParticipantB", fields: [competitionId, participantBId], references: [competitionId, id], onDelete: Restrict)
  winnerParticipant CompetitionParticipant? @relation("MatchWinner", fields: [competitionId, winnerParticipantId], references: [competitionId, id], onDelete: Restrict)
  results         MatchResult[]

  @@unique([executionId, ordinal])
  @@unique([competitionId, id])
  @@map("matches")
}

model MatchResult {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId               String                  @map("match_id") @db.Uuid
  competitionId         String                  @map("competition_id") @db.Uuid
  ruleSetId             String                  @map("rule_set_id") @db.Uuid
  participantAId        String                  @map("participant_a_id") @db.Uuid
  participantBId        String                  @map("participant_b_id") @db.Uuid
  detailJson            Json                    @map("detail_json") @db.JsonB
  resolvedJson          Json                    @map("resolved_json") @db.JsonB
  winnerParticipantId   String?                 @map("winner_participant_id") @db.Uuid
  status                String                  @default("PENDING_CONFIRMATION")
  recordedAt            DateTime                @map("recorded_at") @db.Timestamptz(6)
  recordedById          String                  @map("recorded_by") @db.Uuid
  confirmedAt           DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  confirmedById         String?                 @map("confirmed_by") @db.Uuid
  annulledAt            DateTime?               @map("annulled_at") @db.Timestamptz(6)
  annulledById          String?                 @map("annulled_by") @db.Uuid
  annulmentReason       String?                 @map("annulment_reason")
  revision              Int                     @default(1)
  match                 LogicalMatch            @relation(fields: [competitionId, matchId], references: [competitionId, id], onDelete: Restrict)
  ruleSet               CompetitionRuleSet      @relation(fields: [competitionId, ruleSetId], references: [competitionId, id], onDelete: Restrict)
  participantA          CompetitionParticipant  @relation("ResultParticipantA", fields: [competitionId, participantAId], references: [competitionId, id], onDelete: Restrict)
  participantB          CompetitionParticipant  @relation("ResultParticipantB", fields: [competitionId, participantBId], references: [competitionId, id], onDelete: Restrict)
  winnerParticipant     CompetitionParticipant? @relation("ResultWinner", fields: [competitionId, winnerParticipantId], references: [competitionId, id], onDelete: Restrict)
  recordedBy            User                    @relation("MatchResultRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedBy           User?                   @relation("MatchResultConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  annulledBy            User?                   @relation("MatchResultAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  qualificationSources GroupQualificationSource[]

  @@index([matchId, status])
  @@unique([competitionId, id])
  @@map("match_results")
}

model GroupQualification {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId         String                 @map("competition_id") @db.Uuid
  groupId               String                 @map("group_id") @db.Uuid
  sourceRuleSetId        String                 @map("source_rule_set_id") @db.Uuid
  firstParticipantId    String                 @map("first_participant_id") @db.Uuid
  secondParticipantId   String                 @map("second_participant_id") @db.Uuid
  status                String                 @default("PENDING_CONFIRMATION")
  proposedAt            DateTime               @map("proposed_at") @db.Timestamptz(6)
  proposedById          String                 @map("proposed_by") @db.Uuid
  confirmedAt           DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  confirmedById         String?                @map("confirmed_by") @db.Uuid
  invalidatedAt         DateTime?              @map("invalidated_at") @db.Timestamptz(6)
  invalidatedById       String?                @map("invalidated_by") @db.Uuid
  invalidationReason    String?                @map("invalidation_reason")
  annulledAt            DateTime?              @map("annulled_at") @db.Timestamptz(6)
  annulledById          String?                @map("annulled_by") @db.Uuid
  annulmentReason       String?                @map("annulment_reason")
  revision              Int                    @default(1)
  competition           Competition            @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  group                 DrawGroup              @relation(fields: [competitionId, groupId], references: [competitionId, id], onDelete: Restrict)
  sourceRuleSet         CompetitionRuleSet     @relation(fields: [competitionId, sourceRuleSetId], references: [competitionId, id], onDelete: Restrict)
  firstParticipant      CompetitionParticipant @relation("QualificationFirstParticipant", fields: [competitionId, firstParticipantId], references: [competitionId, id], onDelete: Restrict)
  secondParticipant     CompetitionParticipant @relation("QualificationSecondParticipant", fields: [competitionId, secondParticipantId], references: [competitionId, id], onDelete: Restrict)
  proposedBy            User                   @relation("QualificationProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  confirmedBy           User?                  @relation("QualificationConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  invalidatedBy         User?                  @relation("QualificationInvalidatedBy", fields: [invalidatedById], references: [id], onDelete: Restrict)
  annulledBy            User?                  @relation("QualificationAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  sources               GroupQualificationSource[]

  @@unique([competitionId, id])
  @@index([groupId, status])
  @@map("group_qualifications")
}

model GroupQualificationSource {
  qualificationId String             @map("qualification_id") @db.Uuid
  competitionId   String             @map("competition_id") @db.Uuid
  resultId        String             @map("result_id") @db.Uuid
  ordinal         Int
  qualification   GroupQualification @relation(fields: [competitionId, qualificationId], references: [competitionId, id], onDelete: Restrict)
  result          MatchResult        @relation(fields: [competitionId, resultId], references: [competitionId, id], onDelete: Restrict)

  @@id([qualificationId, resultId])
  @@unique([qualificationId, ordinal])
  @@map("group_qualification_sources")
}

model GroupStanding {
  groupId                  String                 @map("group_id") @db.Uuid
  competitionId            String                 @map("competition_id") @db.Uuid
  participantId            String                 @map("participant_id") @db.Uuid
  position                 Int
  tied                     Boolean                @default(false)
  played                   Int
  wins                     Int
  draws                    Int
  losses                   Int
  tablePoints              Int                    @map("table_points")
  scoreFor                 Int                    @map("score_for")
  scoreAgainst             Int                    @map("score_against")
  scoreDifference          Int                    @map("score_difference")
  setsWon                  Int                    @map("sets_won")
  setsLost                 Int                    @map("sets_lost")
  setDifference            Int                    @map("set_difference")
  sportPointsFor           Int                    @map("sport_points_for")
  sportPointsAgainst       Int                    @map("sport_points_against")
  sportPointDifference     Int                    @map("sport_point_difference")
  recalculatedAt           DateTime               @map("recalculated_at") @db.Timestamptz(6)
  group                    DrawGroup              @relation(fields: [competitionId, groupId], references: [competitionId, id], onDelete: Restrict)
  participant              CompetitionParticipant @relation(fields: [competitionId, participantId], references: [competitionId, id], onDelete: Restrict)

  @@id([groupId, participantId])
  @@map("group_standings")
}
