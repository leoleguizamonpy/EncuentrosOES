{
  "name": "@oes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bootstrap:superadmin": "pnpm --filter @oes/domain build && pnpm --filter @oes/database build && pnpm build && node --env-file=../../.env dist/cli/bootstrap-superadmin.js",
    "coverage": "vitest run --coverage",
    "dev": "pnpm --filter @oes/api... build && node --env-file=../../.env --watch --enable-source-maps dist/main.js",
    "lint": "eslint src test",
    "start": "node --env-file=../../.env --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@oes/database": "workspace:*",
    "@oes/domain": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
