# Template only. Do not commit real production values.
NODE_ENV=production
API_PORT=3001

# Secret: inject from the deployment platform / secret manager.
DATABASE_URL=postgresql://<user>:<password>@<private-db-host>:5432/<database>?schema=public&sslmode=require

# Public HTTPS origin allowed to send credentialed browser requests to the API.
WEB_ORIGIN=https://www.oesparaguay.com

# Public API endpoint compiled into the web application.
NEXT_PUBLIC_API_URL=https://api.oesparaguay.com/api/v1

# Explicit production session policy.
SESSION_ABSOLUTE_MINUTES=720
SESSION_IDLE_MINUTES=30

# Backup destination credentials are provider-specific and must be injected externally.
# Never place access keys, tokens, dump contents or encryption keys in this file.
