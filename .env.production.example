# Template only. Do not commit real production values.
NODE_ENV=production
API_PORT=3001

# Secret: inject from the deployment platform / secret manager.
DATABASE_URL=postgresql://<user>:<password>@<private-db-host>:5432/<database>?schema=public&sslmode=require

# Public HTTPS origin allowed to send credentialed browser requests to the API.
WEB_ORIGIN=https://www.oesparaguay.com

# Public API endpoint compiled into the web application.
NEXT_PUBLIC_API_URL=https://api.oesparaguay.com/api/v1

# Explicit production session policy.
SESSION_ABSOLUTE_MINUTES=720
SESSION_IDLE_MINUTES=30

# Backup transport contract. These values are not credentials.
BACKUP_TRANSPORT_EXECUTABLE=/opt/oes/bin/backup-transport
BACKUP_REMOTE_PREFIX=oes-production
BACKUP_RETENTION_DAYS=30
BACKUP_OUTPUT_DIR=/var/lib/oes-backups/staging

# REAL-STORAGE-DRILL operator metadata/attestations. Do not set these to YES
# until the real destination has been verified as private, encrypted and
# accessible through minimum-privilege credentials.
BACKUP_PROVIDER_LABEL=<provider-and-storage-class>
REAL_STORAGE_PRIVATE_CONFIRMED=NO
REAL_STORAGE_ENCRYPTED_CONFIRMED=NO
REAL_STORAGE_MIN_PRIVILEGE_CONFIRMED=NO
REAL_STORAGE_EVIDENCE_DIR=/var/lib/oes-backups/real-storage-evidence

# Backup destination credentials are provider-specific and must be injected externally.
# Never place access keys, tokens, dump contents or encryption keys in this file.
